configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: true;
    font: "monospace 12";
}

* {
    /* Catppuccin Mocha Colors */
    rosewater: #f5e0dc;
    flamingo: #f2cdcd;
    pink: #f5c2e7;
    mauve: #cba6f7;
    red: #f38ba8;
    maroon: #eba0ac;
    peach: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    teal: #94e2d5;
    sky: #89dceb;
    sapphire: #74c7ec;
    blue: #89b4fa;
    lavender: #b4befe;
    text: #cdd6f4;
    subtext1: #bac2de;
    subtext0: #a6adc8;
    overlay2: #9399b2;
    overlay1: #7f849c;
    overlay0: #6c7086;
    surface2: #585b70;
    surface1: #45475a;
    surface0: #313244;
    base: #1e1e2e;
    mantle: #181825;
    crust: #11111b;

    /* Theme colors with transparency */
    bg-col: #1e1e2ed8;
    bg-col-light: #313244d8;
    border-col: #cba6f77f;
    selected-col: #cba6f74c;
    blue-active: #89b4fab2;
    fg-col: @text;
    fg-col2: @mauve;
    grey: @surface1;
    
    /* Element state colors */
    normal-background: @base;
    normal-foreground: @text;
    selected-background: @selected-col;
    selected-foreground: @fg-col2;
    active-background: @blue-active;
    active-foreground: @base;
    alternate-normal-background: @base;
    alternate-normal-foreground: @text;
}

window {
    width: 50%;
    background-color: @bg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 15px;
    padding: 15px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    background-color: @bg-col-light;
    border-radius: 10px;
    padding: 10px;
    children: [prompt, entry];
}

prompt {
    background-color: @mauve;
    padding: 6px 12px;
    border-radius: 8px;
    text-color: @base;
    font-weight: bold;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    background-color: transparent;
    text-color: @text;
    padding: 6px;
}

listview {
    background-color: @bg-col;
    border-radius: 10px;
    padding: 5px 0px;
    columns: 1;
    lines: 8;
}

element {
    padding: 8px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

element alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

element-icon {
    size: 24px;
}

element selected.normal {
    background-color: @selected-background;
    text-color: @selected-foreground;
}

element normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

element selected.active {
    background-color: @mauve;
    text-color: @base;
}

element alternate.active {
    background-color: @bg-col-light;
    text-color: @text;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
    handle-color: @surface2;
    handle-color-hover: @surface1;
    handle-color-active: @mauve;
}

sidebar {
    background-color: @mantle;
    border-radius: 10px;
    padding: 10px;
}

button {
    background-color: @surface0;
    text-color: @text;
    border-radius: 8px;
    padding: 8px;
}

button selected {
    background-color: @mauve;
    text-color: @base;
}

message {
    background-color: @bg-col-light;
    border-radius: 10px;
    padding: 10px;
    border: 2px;
    border-color: @border-col;
}

textbox {
    background-color: @bg-col-light;
    text-color: @text;
    border-radius: 10px;
    padding: 10px;
}

error-message {
    background-color: @red;
    text-color: @base;
    border-radius: 10px;
    padding: 10px;
}
